[Unit]
Description=nginx-stream: relay ports open in the host firewall
# own unit, not a saved ruleset snapshot; it follows the other firewall: restart, reload, stop + start
# (start of nftables: its drop-in)
After=network-pre.target nftables.service netfilter-persistent.service iptables.service ip6tables.service ufw.service firewalld.service
PartOf=nftables.service netfilter-persistent.service
ReloadPropagatedFrom=nftables.service netfilter-persistent.service
Wants=network-pre.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/etc/nginx-stream/ports.sh up
ExecReload=/etc/nginx-stream/ports.sh up
ExecStop=-/etc/nginx-stream/ports.sh down

[Install]
WantedBy=multi-user.target netfilter-persistent.service
