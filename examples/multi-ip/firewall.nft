#!/usr/sbin/nft -f
# nginx-stream: own table only, other rules are not touched
table inet nginx_stream
delete table inet nginx_stream
table inet nginx_stream {
	set ssh4 { type ipv4_addr; size 65535; flags dynamic,timeout; timeout 2m; }
	set ssh6 { type ipv6_addr; size 65535; flags dynamic,timeout; timeout 2m; }
	chain input {
		type filter hook input priority -10; policy accept;
		# ssh-protect: >10 new connections/min from one /24 (IPv6: /64) are dropped (bare SYN, no conntrack)
		tcp dport 22 tcp flags & (fin|syn|rst|ack) == syn update @ssh4 { ip saddr and 255.255.255.0 limit rate over 10/minute burst 10 packets } drop
		tcp dport 22 tcp flags & (fin|syn|rst|ack) == syn update @ssh6 { ip6 saddr and ffff:ffff:ffff:ffff:: limit rate over 10/minute burst 10 packets } drop
	}
}
