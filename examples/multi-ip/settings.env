# nginx-stream settings (written by the installer; sourced by it on reconfigure)
UI_LANG=ru
TARGET=2001:db8::10
PORTS=udp:192.0.2.20:443\>\[2001:db8::20\]:443\,udp:192.0.2.21:443\>\[2001:db8::21\]:443@\[2001:db8::5\]\,tcp:192.0.2.20:443\,tcp:\[2001:db8::1\]:8443\>203.0.113.10:443@192.0.2.20\,tcp:2222\>203.0.113.20:22
LISTEN=v4v6
PROXY_PROTOCOL=n
LOGS=off
TCP_TIMEOUT=10m
UDP_TIMEOUT=10m
TUNE=y
SSH_PROTECT=y
SCAN_PROTECT=n
AUTO_UPDATES=y
NGINX_MODE=own
NGINX_FRESH=y
DEFAULT_SITE_REMOVED=n
UFW_RULES=''
INSTALLER_VERSION=1.1.0
