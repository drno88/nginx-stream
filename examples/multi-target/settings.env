# nginx-stream settings (written by the installer; sourced by it on reconfigure)
UI_LANG=ru
TARGET=2001:db8::10
PORTS=tcp:443\,tcp:2222\>203.0.113.20:22\,udp:51820\>\[2001:db8::20\]:51820
LISTEN=v4v6
PROXY_PROTOCOL=n
LOGS=off
TCP_TIMEOUT=10m
UDP_TIMEOUT=10m
TUNE=y
SSH_PROTECT=y
SCAN_PROTECT=y
AUTO_UPDATES=y
NGINX_MODE=own
NGINX_FRESH=y
DEFAULT_SITE_REMOVED=n
UFW_RULES=''
INSTALLER_VERSION=1.0.0
