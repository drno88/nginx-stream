# nginx-stream settings (written by the installer; sourced by it on reconfigure)
UI_LANG=ru
TARGET=203.0.113.9
PORTS=tcp:443/a.example.com\>\[2001:db8::10\]:443\,tcp:443/\*.b.example.com\>203.0.113.5:443@192.0.2.21\,tcp:443\>203.0.113.9:443\,udp:443\>203.0.113.9:443
LISTEN=v4v6
PROXY_PROTOCOL=n
LOGS=off
TCP_TIMEOUT=10m
UDP_TIMEOUT=10m
TUNE=y
SSH_PROTECT=y
SCAN_PROTECT=n
AUTO_UPDATES=y
NGINX_MODE=own
NGINX_FRESH=y
DEFAULT_SITE_REMOVED=n
UFW_RULES=''
INSTALLER_VERSION=1.0.0
